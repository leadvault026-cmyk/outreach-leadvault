# LeadVault Outreach — environment variables (NAMES ONLY — never commit real values).
# Copy to .env.local for local development. For the local Supabase stack, values come from
# `npx supabase status`. Deployed environments set these in the host's secret manager (Railway).

# ── Runtime ────────────────────────────────────────────────────────────────
# local | staging | production   (controls environment banner, HSTS, CSP upgrade-insecure-requests)
APP_ENV=
# Public base URL of this app, e.g. http://localhost:3000 (used in auth email links)
APP_BASE_URL=
# debug | info | warn | error
LOG_LEVEL=

# ── Supabase ───────────────────────────────────────────────────────────────
# Project API URL
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe for browsers by design; used here server-side for auth only
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET key — server-only. Admin operations (local seed now; invitations later). Never expose.
SUPABASE_SECRET_KEY=

# ── Database ───────────────────────────────────────────────────────────────
# Application connection (Supabase session-mode pooler in deployed environments)
DATABASE_URL=
# Migration connection (direct or session pooler); falls back to DATABASE_URL
DATABASE_MIGRATION_URL=

# ── Local development only ─────────────────────────────────────────────────
# Password for the fictional demo accounts created by `npm run db:seed` (≥12 chars, upper,
# lower, digit). Local stack only — the seed refuses to run anywhere else.
SEED_DEMO_PASSWORD=

# ── Email transport ────────────────────────────────────────────────────────
# fake (default) | live. "fake" records messages as sent but NO email leaves the machine.
# "live" needs a purchased, connected provider; none is connected in this build, so nothing sends.
EMAIL_TRANSPORT=
# Kill switch: "false" stops the worker from sending anything.
SENDING_ENABLED=
# HMAC key for unsubscribe links, at least 32 characters (generate a random value; never commit it).
UNSUBSCRIBE_SIGNING_SECRET=
# Public base URL used in unsubscribe links (defaults to APP_BASE_URL), e.g. http://localhost:3100
UNSUBSCRIBE_BASE_URL=

# ── Later (not used yet) ───────────────────────────────────────────────────
# CREDENTIALS_ENCRYPTION_KEY=         # base64 32 bytes, AES-256-GCM for real mailbox credentials
# CREDENTIALS_ENCRYPTION_KEY_VERSION=
# SEND_ALLOWLIST_DOMAINS=             # non-production send allowlist for the first live tests
# RESEND_API_KEY=                     # system email: auth/invites/alerts only (pre-production)
# SYSTEM_EMAIL_FROM=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# WORKER_ID=
